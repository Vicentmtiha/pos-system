@app.get("/settings")
def store_settings_page(request: Request, db: Session = Depends(get_db), admin: User = Depends(require_admin)):
    store = db.query(Store).filter(Store.id == admin.store_id).first()
    return templates.TemplateResponse(
        request=request,
        name="settings.html",
        context={"store": store, "current_user": admin}
    )


