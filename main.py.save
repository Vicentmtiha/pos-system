# Ongeza hii route ya POST hapa chini yake ili kupokea data za mauzo kutoka kwenye kitufe cha "Complete Sales"
@app.post("/orders/create")
def save_new_order(
    request: Request, 
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    if not current_user:
        return RedirectResponse(url="/login", status_code=status.HTTP_303_SEE_OTHER)
    
    # Weka hapa mantiki (logic) yako ya kuchukua data zinazotumwa na JavaScript,
    # kupunguza idadi ya bidhaa stoo (stock), na kuhifadhi Oda kwenye database.
    
    return {"message": "Oda imehifadhiwa mafanikio!"}
@app.get("/api/products/search")
def api_search_product(barcode: Optional[str] = None, query: Optional[str] = None, db: Session = Depends(get_db), current_user: User = Depends(get_current_user)):
    if not current_user:
        raise HTTPException(status_code=401, detail="Unauthorized")
        
    db_query = db.query(Product).filter(Product.store_id == current_user.store_id)
    
    if barcode:
        product = db_query.filter(Product.barcode == barcode).first()
        if not product:
            raise HTTPException(status_code=404, detail="Bidhaa haijapatikana kwa Barcode hiyo")
        return [{
            "id": product.id,
            "name": product.name,
            "barcode": product.barcode,
            "size": product.size,
            "price": product.price,
            "quantity": product.quantity
        }]
        
    if query:
        products = db_query.filter(
            (Product.name.ilike(f"%{query}%")) | 
            (Product.barcode.ilike(f"%{query}%")) | 
            (Product.size.ilike(f"%{query}%"))
        ).all()
        return [{
            "id": p.id,
            "name": p.name,
            "barcode": p.barcode,
            "size": p.size,
            "price": p.price,
            "quantity": p.quantity
        } for p in products]
        
    return []

