@app.get("/expenses")
def list_expenses(request: Request, db: Session = Depends(get_db)):
    current_user = get_current_user(request, db)
    if not current_user:
        return RedirectResponse(url="/login", status_code=status.HTTP_303_SEE_OTHER)

    return templates.TemplateResponse(
        request=request,
        name="expenses.html",
        context={
            "expenses": [],
            "total_expenses": 0.0,
            "current_user": current_user
        }
    )

@app.post("/expenses/add")
def add_expense(
    title: str = Form(...),
    amount: float = Form(...),
    category: str = Form("Genel"),
    note: Optional[str] = Form(None),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):
    if not current_user:
        return RedirectResponse(url="/login", status_code=status.HTTP_303_SEE_OTHER)
        
    return RedirectResponse(url="/expenses", status_code=status.HTTP_303_SEE_OTHER)


# ==========================================
# 10. ADVANCED REPORTS & ANALYTICS
# ==========================================
@app.get("/reports/sales")
def sales_report(
    request: Request, 
    start_date: Optional[str] = None, 
    end_date: Optional[str] = None, 
    db: Session = Depends(get_db)
):
    current_user = get_current_user(request, db)
    if not current_user:
        return RedirectResponse(url="/login", status_code=status.HTTP_303_SEE_OTHER)

    query = db.query(Order).filter(
        Order.store_id == current_user.store_id,
        Order.status == OrderStatus.COMPLETED
    )

    if start_date:
        query = query.filter(Order.created_at >= datetime.strptime(start_date, "%Y-%m-%d"))
    if end_date:
        query = query.filter(Order.created_at <= datetime.strptime(end_date + " 23:59:59", "%Y-%m-%d %H:%M:%S"))

    orders = query.all()
    
    grand_total = sum(o.total_amount for o in orders)
    total_items_sold = sum(sum(item.quantity for item in o.order_items) for o in orders)

    return templates.TemplateResponse(
        request=request,
        name="sales_report.html",
        context={
            "orders": orders,
            "grand_total": grand_total,
            "total_items_sold": total_items_sold,
            "start_date": start_date,
            "end_date": end_date,
            "current_user": current_user
        }
    )

@app.get("/reports/stock-valuation")
def stock_valuation_report(request: Request, db: Session = Depends(get_db)):
    current_user = get_current_user(request, db)
    if not current_user:
        return RedirectResponse(url="/login", status_code=status.HTTP_303_SEE_OTHER)

    products = db.query(Product).filter(Product.store_id == current_user.store_id).all()
    
    total_stock_buying_value = sum((p.cost_price or 0) * p.quantity for p in products)
    total_stock_selling_value = sum(p.price * p.quantity for p in products)
    potential_profit = total_stock_selling_value - total_stock_buying_value

    return templates.TemplateResponse(
        request=request,
        name="stock_valuation.html",
        context={
            "products": products,
            "total_buying": total_stock_buying_value,
            "total_selling": total_stock_selling_value,
            "potential_profit": potential_profit,
            "current_user": current_user
        }
    )

@app.get("/reports/profit-loss")
def profit_loss_report(request: Request, db: Session = Depends(get_db)):
    current_user = get_current_user(request, db)
    if not current_user:
        return RedirectResponse(url="/login", status_code=status.HTTP_303_SEE_OTHER)

    orders = db.query(Order).filter(
        Order.store_id == current_user.store_id,
        Order.status == OrderStatus.COMPLETED
    ).all()
    
    total_revenue = sum(order.total_amount for order in orders if hasattr(order, 'total_amount'))
    
    total_cogs = 0  # <--- Imeongezwa hapa kuzuia TypeError ya undefined
    for order in orders:
        if hasattr(order, 'order_items') and order.order_items:
            for item in order.order_items:
                if item.product and hasattr(item.product, 'cost_price') and item.product.cost_price:
                    total_cogs += (item.product.cost_price * item.quantity)

    net_profit = total_revenue - total_cogs

    return templates.TemplateResponse(
        request=request,
        name="profit_loss.html",
        context={
            "current_user": current_user,
            "total_revenue": total_revenue,
            "total_cost": total_cogs,
            "total_cogs": total_cogs,  # <--- Imetumwa kwa template ya profit_loss.html
            "net_profit": net_profit,
            "orders": orders
        }
    )

@app.get("/reports/inventory")
def inventory_report(request: Request, db: Session = Depends(get_db)):
    current_user = get_current_user(request, db)
    if not current_user:
        return RedirectResponse(url="/login", status_code=status.HTTP_303_SEE_OTHER)

    products = db.query(Product).filter(Product.store_id == current_user.store_id).all()

    return templates.TemplateResponse(
        request=request,
        name="inventory_report.html",
        context={
            "current_user": current_user,
            "products": products
        }
    )


