
{% block content %}
    <h1>Karibu CORE-WISP Dashboard</h1>
    
    <!-- Sehemu ya Takwimu -->
    <div style="display: flex; gap: 20px; margin-bottom: 30px;">
        <div style="background: white; padding: 20px; border-radius: 8px; border-left: 5px solid #3498db; width: 200px;">
            <h3>Jumla ya Bidhaa</h3>
            <p style="font-size: 24px; font-weight: bold;">{{ stats.total_products }}</p>
        </div>
        <div style="background: white; padding: 20px; border-radius: 8px; border-left: 5px solid #27ae60; width: 200px;">
            <h3>Jumla ya Oda</h3>
            <p style="font-size: 24px; font-weight: bold;">{{ stats.total_orders }}</p>
        </div>
    </div>

    <!-- Sehemu ya Table ya Bidhaa -->
    <h2>Orodha ya Bidhaa</h2>
    <table border="1" style="width: 100%; border-collapse: collapse; background: white; text-align: left;">
        <thead>
            <tr style="background: #2c3e50; color: white;">
                <th style="padding: 10px;">Jina la Bidhaa</th>
                <th style="padding: 10px;">Bei (TZS)</th>
                <th style="padding: 10px;">Kiasi</th>
            </tr>
        </thead>
        <tbody>
            {% for product in products %}
            <tr>
                <td style="padding: 10px;">{{ product.name }}</td>
                <td style="padding: 10px;">{{ product.price }}</td>
                <td style="padding: 10px;">{{ product.quantity }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="3" style="padding: 10px; text-align: center;">Hakuna bidhaa zilizoongezwa bado.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
